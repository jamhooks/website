---
// The JamHooks logo from the brand kit (public/brandkit/v1/README.md), in the white and
// coral version made for dark teal backgrounds. The link around it carries the
// accessible name, so the image itself has an empty alt.
interface Props {
	height?: number;
}
const { height = 34 } = Astro.props;
// logo-on-dark.svg is 1060 x 304.
const width = Math.round((height * 1060) / 304);
---

<img src="/brandkit/v1/logo-on-dark.svg" width={width} height={height} alt="" />
