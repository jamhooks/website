---
// The Jamhooks mark: a hook that starts at a flow node. Same drawing as public/favicon.svg.
interface Props {
	size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
	<rect width="32" height="32" rx="8" fill="#ff7a45"></rect>
	<path
		d="M21 13.5V19a5 5 0 0 1-10 0"
		fill="none"
		stroke="#0b0c10"
		stroke-width="3"
		stroke-linecap="round"></path>
	<circle cx="21" cy="8.5" r="2.5" fill="#0b0c10"></circle>
</svg>
